# NEIS 교육정보 개방 포털에서 발급받은 인증키
NEIS_API_KEY=여기에_NEIS_인증키

# Supabase 프로젝트의 Project URL / anon key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 상문고등학교 설정: API 학교검색 결과를 확인한 뒤 입력하세요.
SCHOOL_NAME=상문고등학교
SCHOOL_REGION=서울특별시
NEIS_ATPT_OFCDC_SC_CODE=B10
# 아래 학교코드는 학교검색 API 응답을 확인한 후 실제 값으로 설정
NEIS_SD_SCHUL_CODE=

# 실제 배포한 사이트의 정식 URL (예: https://sangmoon-master.vercel.app)
NEXT_PUBLIC_SITE_URL=
# 네이버 서치어드바이저에서 발급받은 사이트 소유확인 코드 (content 값만)
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
